<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/MainMenu_USS.uss?fileID=7433441132597879392&amp;guid=0180c6486e0baea47a3bae93411de930&amp;type=3#MainMenu_USS" />
    <ui:VisualElement name="MainMenu_Root" style="flex-grow: 1;">
        <ui:VisualElement name="VE_Background" picking-mode="Ignore" enabled="true" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/MainMenu/MainMenuBG_SpriteSheet.png?fileID=-2921952315550093136&amp;guid=bf33d741952603949a46fcf146ab0070&amp;type=3#MainMenuBG_1&quot;);">
            <ui:VisualElement name="VE_ScreenPortion_Up" style="flex-grow: 1; justify-content: space-between; align-items: center; height: 60%; width: 100%; margin-top: 4%;">
                <ui:VisualElement name="VE_TitleIMG" focusable="true" class="titleGame-MainMenu" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/MainMenu/GameTitle_Img.png?fileID=6758501636435385874&amp;guid=50c3865025bfb474993f26aee30d4d18&amp;type=3#GameTitle_Img_0&quot;); width: 50%; height: 50%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%;" />
            </ui:VisualElement>
            <ui:VisualElement name="VE_ScreenPortion_Down" picking-mode="Ignore" style="flex-grow: 1; align-self: center; align-items: center; width: 100%; height: 50%; margin-top: 2%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%;">
                <ui:VisualElement name="VE_ButtonContainer" picking-mode="Ignore" style="flex-grow: 1; width: 20%; height: 50%; justify-content: flex-start; align-self: center; margin-bottom: 0%; margin-top: 0%;">
                    <ui:Button text="Start" name="BT_Start" style="width: 100%; height: 25%; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Sprites/UI/Buttons_SpriteSheet.png?fileID=1635634158&amp;guid=ce8b0d13eac7db94da6ae819d77ff9da&amp;type=3#Buttons_1&quot;); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Alegreya_SC/AlegreyaSC-Medium.ttf?fileID=12800000&amp;guid=63b71c41ba570ed4f9c4f67b8f630c64&amp;type=3#AlegreyaSC-Medium&quot;); color: rgb(255, 255, 255); font-size: 40%; margin-top: 4%; margin-right: 0%; margin-bottom: 5%; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                    <ui:Button text="Exit" name="BT_Exit" style="width: 100%; height: 25%; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Sprites/UI/Buttons_SpriteSheet.png?fileID=1635634158&amp;guid=ce8b0d13eac7db94da6ae819d77ff9da&amp;type=3#Buttons_1&quot;); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Alegreya_SC/AlegreyaSC-Medium.ttf?fileID=12800000&amp;guid=63b71c41ba570ed4f9c4f67b8f630c64&amp;type=3#AlegreyaSC-Medium&quot;); color: rgb(255, 255, 255); font-size: 40%; margin-top: 4%; margin-right: 0%; margin-bottom: 4%; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
