VisualElement {
}

.containerRoot {
    width: 100%;
    height: 100%;
    overflow: hidden;
    flex-wrap: nowrap;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.hubBoardBG {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: row;
    background-image: url("project://database/Assets/Sprites/UI/HUB/HUB_Background.png?fileID=2929293088917789154&guid=2485f48c47ca0844da8b6f4237b446ef&type=3#HUB_Background");
    background-size: 90% 90%;
    align-content: stretch;
    align-items: center;
    justify-content: space-evenly;
    align-self: stretch;
}

.postitContainer {
    width: 82%;
    height: 80%;
    translate: 0 0;
    background-size: 90% 90%;
    align-content: center;
    flex-basis: auto;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.hubPostItBG {
    background-image: url("project://database/Assets/Sprites/UI/HUB/HUB_Postit.png?fileID=-771178016512510283&guid=2fee190bb300629448013bbd72862d77&type=3#HUB_Postit");
    width: 20%;
    height: 30%;
    position: relative;
    top: auto;
    left: auto;
    flex-direction: column;
    flex-grow: 0;
    align-self: center;
    background-size: 100% 100%;
    flex-shrink: 1;
    transform-origin: center;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    flex-wrap: wrap;
    align-content: stretch;
    justify-content: center;
    align-items: flex-start;
    text-overflow: clip;
    overflow: hidden;
    padding-top: 20px;
    padding-right: 50px;
    padding-bottom: 20px;
    padding-left: 50px;
    min-width: 20%;
    min-height: 35%;
    max-width: 20%;
    max-height: 35%;
    background-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(248, 200, 200);
}

.hubPostitBG :hover {
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(204, 128, 128);
    scale: 1.2 1.2;
    transition-timing-function: ease-in;
    transition-duration: 300ms;
    rotate: -4deg;
}

.postitTextCaseName {
    width: auto;
    height: auto;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    align-self: flex-start;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Bold.ttf?fileID=12800000&guid=95d4e510a4bd39a43b903579841fa8c5&type=3#Namdhinggo-Bold");
    font-size: 20px;
}

.postitTextInformation {
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Regular.ttf?fileID=12800000&guid=78f42b1dfd248c340a87959678417eb8&type=3#Namdhinggo-Regular");
    font-size: 16px;
}

.reputationLabel {
    background-color: rgba(132, 88, 94, 0.6);
    width: 80%;
    height: 15%;
    right: 0;
    left: 0;
    align-items: center;
    align-self: center;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    overflow: hidden;
    visibility: visible;
}

.reputationLabelText {
    align-self: center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Regular.ttf?fileID=12800000&guid=78f42b1dfd248c340a87959678417eb8&type=3#Namdhinggo-Regular");
    font-size: 16px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.postitLine {
    background-image: url("project://database/Assets/Sprites/UI/HUB/HUB_LinePostit.png?fileID=-3633429660747953178&guid=0feee035eb3688a439a2395b8c3af4a1&type=3#HUB_LinePostit");
    width: 100%;
    height: 1%;
    min-width: auto;
    min-height: auto;
    max-width: none;
    max-height: none;
}

.unity-button {
}

.scaledPostitBG {
    width: 50%;
    height: 70%;
    background-image: url("project://database/Assets/Sprites/UI/HUB/HUB_Postit.png?fileID=-771178016512510283&guid=2fee190bb300629448013bbd72862d77&type=3#HUB_Postit");
    position: absolute;
    align-self: center;
    align-items: flex-start;
    align-content: center;
    justify-content: space-between;
    flex-wrap: wrap;
    overflow: hidden;
    -unity-background-image-tint-color: rgb(248, 200, 200);
    padding-top: 50px;
    padding-right: 50px;
    padding-bottom: 50px;
    padding-left: 50px;
}

.scaledPostit_CaseName {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-ExtraBold.ttf?fileID=12800000&guid=8053a2bebcfda524aa6050fe55a05a14&type=3#Namdhinggo-ExtraBold");
    font-size: 30px;
}

.scaledPostitLine {
    width: 100%;
    height: 0.5%;
    background-image: url("project://database/Assets/Sprites/UI/HUB/HUB_BigLinePostit.png?fileID=-4277312520521621370&guid=3a168130b254f6049b72f759a43c1161&type=3#HUB_BigLinePostit");
    max-height: 15px;
    min-height: 5px;
}

.textContainer_ScaledPostit {
    flex-direction: row;
    width: 100%;
    height: 20%;
    -unity-text-align: upper-left;
    align-self: center;
    align-items: center;
    min-height: 20%;
    max-height: 30%;
}

.applicantInformationContainer {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    align-items: center;
    flex-wrap: wrap;
    overflow: hidden;
    width: 100%;
    height: 20%;
}

.titleSectionInformationText {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Bold.ttf?fileID=12800000&guid=95d4e510a4bd39a43b903579841fa8c5&type=3#Namdhinggo-Bold");
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: middle-left;
    flex-wrap: wrap;
    width: 100%;
    height: 5%;
}

.titleSectionContainer {
    background-color: rgb(132, 88, 94);
    width: 100%;
    height: 20%;
    align-items: center;
    justify-content: center;
    align-self: center;
    min-width: 100%;
    max-width: 100px;
    max-height: 25%;
    min-height: 10%;
    padding-right: 20px;
    padding-left: 20px;
}

.descriptionRequestText {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 50%;
    flex-wrap: wrap;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Regular.ttf?fileID=12800000&guid=78f42b1dfd248c340a87959678417eb8&type=3#Namdhinggo-Regular");
    font-size: 20px;
    white-space: pre-wrap;
    -unity-text-align: upper-left;
}

.descriptionContainer {
    width: 100%;
    height: auto;
    flex-wrap: wrap;
    overflow: hidden;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    text-overflow: clip;
}

.applicantText {
    height: auto;
    min-height: auto;
    width: auto;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Regular.ttf?fileID=12800000&guid=78f42b1dfd248c340a87959678417eb8&type=3#Namdhinggo-Regular");
    font-size: 20px;
}
