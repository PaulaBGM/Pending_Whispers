    <ui:VisualElement name="ItemSlot_Root" picking-mode="Ignore" style="flex-grow: 0; width: 85px; height: 85px; min-width: 80px; min-height: 80px; flex-basis: initial; flex-shrink: 0; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;">
        <ui:Button name="ItemSlot_BG" class="inventory-slot" style="width: 80px; height: 80px; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; right: auto; left: auto; background-color: rgba(99, 69, 38, 0.79); border-top-left-radius: 15%; border-top-right-radius: 15%; border-bottom-right-radius: 15%; border-bottom-left-radius: 15%; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(214, 214, 214); border-right-color: rgb(214, 214, 214); border-top-color: rgb(214, 214, 214); border-bottom-color: rgb(214, 214, 214);">
