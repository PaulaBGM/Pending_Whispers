VisualElement {
}

.unity-button:hover {
    -unity-background-image-tint-color: rgb(113, 113, 113);
    transition-duration: 0.2s;
    background-color: rgba(255, 255, 255, 0);
    rotate: 0;
    scale: 1.1 1.1;
}

.unity-button:active {
    scale: 0.9 0.9;
    transition-timing-function: ease-in-out;
    transition-duration: 0.2s;
}

.inventory-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
}
