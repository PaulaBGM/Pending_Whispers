    <ui:VisualElement name="HUD_GameNotification" class="gameNotification" style="flex-grow: 1;">
        <ui:Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam sed euismod orci. Maecenas egestas nibh sed tortor sagittis volutpat. " name="T_GameNotification" class="gameNotificationText" />
