        <ui:VisualElement name="HUD_WindownQuarter_3" class="windowQuarterContainer windowQuarterContainerLeft" style="flex-grow: 1;" />
        <ui:VisualElement name="HUD_WindownQuarter_4" class="windowQuarterContainerRight" style="flex-grow: 1;">
            <ui:VisualElement name="HUD_Ability_Container" class="abilityContainer" style="flex-grow: 1;">
                <ui:Button name="HUD_Ability_Button" class="abilityButton" />
