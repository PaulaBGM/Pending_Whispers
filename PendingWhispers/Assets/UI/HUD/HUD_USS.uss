VisualElement {
}

.root {
    flex-wrap: wrap;
    flex-direction: row;
}

.windowQuarterContainerLeft {
    top: 0;
    left: 0;
    width: 50%;
    height: 50%;
}

.windowQuarterContainerRight {
    top: 0;
    left: 0;
    width: 50%;
    height: 50%;
    align-items: flex-end;
}

.notebookContainer {
    left: 0;
    top: 0;
    width: 20%;
    height: 20%;
    padding-top: 25px;
    padding-right: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
}

.notebookButton {
    background-image: url("project://database/Assets/Sprites/UI/HUDNotebook_Icon.png?fileID=21300000&guid=bd90ade5dedf13144816e4a66d51ed1b&type=3#HUDNotebook_Icon");
    height: 30%;
    width: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-end;
    align-content: flex-end;
    align-items: stretch;
    overflow: visible;
    transition-duration: 0.3s;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.notebookButton:hover {
    -unity-background-image-tint-color: rgb(204, 204, 204);
    background-size: 100% 100%;
    background-image: url("project://database/Assets/Sprites/UI/HUDNotebook_Icon.png?fileID=21300000&guid=bd90ade5dedf13144816e4a66d51ed1b&type=3#HUDNotebook_Icon");
    background-repeat: no-repeat no-repeat;
    scale: 0.98 0.98;
    transition-duration: 0.2s;
}

.mapContainer {
    left: auto;
    top: 0;
    width: 30%;
    height: 20%;
    padding-top: 25px;
    padding-right: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
    right: 0;
    flex-direction: row;
    align-content: center;
    justify-content: flex-end;
}

.mapButton {
    background-image: url("project://database/Assets/Sprites/Case1/ItemsCase1_SpriteSheet.png?fileID=2241398343323591403&guid=da2d0d866ce4663468e166eea4f8b855&type=3#Map_Icon");
    height: 30%;
    width: 80%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
    right: 0;
    top: 0;
    transition-duration: 0.2s;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.emptyContainer {
    left: 0;
    bottom: 0;
    width: 50%;
    height: 50%;
}

.abilityContainer {
    left: auto;
    top: auto;
    width: 30%;
    height: 20%;
    padding-top: 25px;
    padding-right: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
    right: 0;
    flex-direction: row;
    align-content: center;
    justify-content: flex-end;
    bottom: 0;
    align-self: flex-end;
    align-items: flex-end;
}

.abilityButton {
    background-image: url("project://database/Assets/Sprites/UI/SpectralWaveHUD_Icon.png?fileID=21300000&guid=102ca9a087043be4bbc87ca11c7dd813&type=3#SpectralWaveHUD_Icon");
    height: 37%;
    width: 80%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
    right: 0;
    top: 0;
    transition-duration: 0.2s;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.notebookNotification {
    background-image: url("project://database/Assets/Sprites/UI/Notebook/Notebook_Bookmark.png?fileID=21300000&guid=e743556ac25a60e44ba99cf086cefd1b&type=3#Notebook_Bookmark");
    bottom: 0;
    position: absolute;
    right: 0;
    width: 20%;
    height: 10%;
    max-height: 20%;
    translate: -50px -369px;
    background-position-x: center -6px;
    padding-right: 0;
    padding-left: 0;
    align-items: center;
    align-self: center;
    align-content: center;
    justify-content: center;
    padding-top: 0;
    padding-bottom: 0;
    transition-property: translate;
}

.notebookNotification.visible {
    background-image: url("project://database/Assets/Sprites/UI/Notebook/Notebook_Bookmark.png?fileID=21300000&guid=e743556ac25a60e44ba99cf086cefd1b&type=3#Notebook_Bookmark");
    bottom: 0;
    position: absolute;
    right: 0;
    width: 20%;
    height: 10%;
    max-height: 20%;
    translate: -50px -340px;
    background-position-x: center -6px;
    padding-right: 0;
    padding-left: 0;
    align-items: center;
    align-self: center;
    align-content: center;
    justify-content: center;
    padding-top: 0;
    padding-bottom: 0;
}

.notificationText {
    color: rgb(255, 255, 255);
    font-size: 12px;
    width: 50%;
    height: 50%;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Bold.ttf?fileID=12800000&guid=95d4e510a4bd39a43b903579841fa8c5&type=3#Namdhinggo-Bold");
}

.mapButton:hover {
    -unity-background-image-tint-color: rgb(183, 183, 183);
    transition-duration: 0.2s;
    scale: 0.95 0.95;
}

.abilityButton:hover {
    -unity-background-image-tint-color: rgb(197, 197, 197);
    background-color: rgba(183, 183, 183, 0);
    transition-duration: 0s;
    scale: 0.95 0.95;
}

.gameNotification {
    position: absolute;
    align-self: center;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    height: 11%;
    background-color: rgba(0, 0, 0, 0.48);
    border-top-left-radius: 62px;
    border-top-right-radius: 62px;
    border-bottom-right-radius: 62px;
    border-bottom-left-radius: 62px;
    justify-content: center;
    width: 60%;
    align-items: center;
    border-left-color: rgb(192, 163, 93);
    border-right-color: rgb(192, 163, 93);
    border-top-color: rgb(192, 163, 93);
    border-bottom-color: rgb(192, 163, 93);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    flex-wrap: wrap;
    padding-top: 25px;
    padding-right: 20px;
    padding-bottom: 25px;
    padding-left: 25px;
    translate: 0 -320px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.2s, 0.7s;
}

.gameNotification.visible {
    position: absolute;
    align-self: center;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    height: 11%;
    background-color: rgba(0, 0, 0, 0.48);
    border-top-left-radius: 62px;
    border-top-right-radius: 62px;
    border-bottom-right-radius: 62px;
    border-bottom-left-radius: 62px;
    justify-content: center;
    width: 60%;
    align-items: center;
    border-left-color: rgb(192, 163, 93);
    border-right-color: rgb(192, 163, 93);
    border-top-color: rgb(192, 163, 93);
    border-bottom-color: rgb(192, 163, 93);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    flex-wrap: wrap;
    padding-top: 25px;
    padding-right: 20px;
    padding-bottom: 25px;
    padding-left: 25px;
}

.gameNotificationText {
    font-size: 35px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Medium.ttf?fileID=12800000&guid=5f4608cda1eb4784fb3f9b0595353d58&type=3#Namdhinggo-Medium");
    color: rgb(255, 255, 255);
    flex-wrap: wrap;
    white-space: pre-wrap;
    -unity-text-align: middle-left;
}
