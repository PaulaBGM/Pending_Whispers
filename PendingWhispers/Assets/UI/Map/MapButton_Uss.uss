VisualElement {
}

.unity-button:hover {
    -unity-background-image-tint-color: rgb(221, 161, 110);
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.unity-button:active {
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    scale: 0.9 0.9;
    -unity-background-image-tint-color: rgb(152, 152, 152);
}

.unity-button:enabled {
    transition-timing-function: ease-out-back;
    transition-duration: 0.45s;
    scale: 1.1 1.1;
    opacity: 1;
}

/* UIT_MapController oculta los nodos con SetEnabled(false): bloqueados o pendientes de aparecer.
   Al activarse, la transicion de :enabled hace el pop-up (0 -> 1.1 con rebote). */
.unity-button:disabled {
    scale: 0 0;
    opacity: 0;
}
