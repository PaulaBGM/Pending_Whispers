VisualElement {
}

.unity-button:hover {
    -unity-background-image-tint-color: rgb(207, 202, 202);
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.unity-button:active {
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    scale: 0.9 0.9;
    -unity-background-image-tint-color: rgb(152, 152, 152);
}

.unity-button:enabled {
    transition-timing-function: ease-in-cubic;
    transition-duration: 0.5s;
    scale: 1.1 1.1;
}
