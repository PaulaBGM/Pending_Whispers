            <ui:VisualElement name="VE_Buttons_Container" style="flex-grow: 1; width: 20%; height: 20%; align-items: center; justify-content: space-around; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; align-content: center;">
