            <ui:VisualElement name="VE_Buttons_Container2" style="flex-grow: 1; width: 20%; height: 20%; align-items: center; justify-content: space-around; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; align-content: center;">
                <ui:Button text="Yes" name="BT_Up_Confirmation" style="width: 100%; height: 40%; font-size: 20%; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Namdhinggo/Namdhinggo-Regular.ttf?fileID=12800000&amp;guid=78f42b1dfd248c340a87959678417eb8&amp;type=3#Namdhinggo-Regular&quot;); color: rgb(255, 255, 255); background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Sprites/UI/Buttons_SpriteSheet.png?fileID=1635634158&amp;guid=ce8b0d13eac7db94da6ae819d77ff9da&amp;type=3#Buttons_1&quot;); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%;" />
