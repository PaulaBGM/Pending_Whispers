<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Pause_Save_Menu/Pause_Save_Menu_USS.uss?fileID=7433441132597879392&amp;guid=e8a1a463c7826fc478170902da8f85b2&amp;type=3#Pause_Save_Menu_USS" />
    <ui:VisualElement name="PauseSaveMenu_Root" style="flex-grow: 1;">
        <ui:VisualElement name="VE_PauseSaveMenu_BG" enabled="true" class="pauseSaveMenu" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Recuadros_Pausa.png?fileID=21300000&amp;guid=8c479a4055694f544b16e6ca18fd9ec2&amp;type=3#Recuadros_Pausa&quot;); align-items: center; justify-content: center; display: none; transition-duration: 0.5s, 0.3s; transition-property: all, scale; transition-timing-function: ease, ease-in-out-bounce; transition-delay: 0s, 0.5s;">
            <ui:VisualElement name="Empty" style="flex-grow: 1; width: 30%; height: 20%;" />
